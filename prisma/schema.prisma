generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusAbsensi {
  HADIR
  IZIN
  SAKIT
  ALPHA
}

enum StatusHarian {
  HADIR
  IZIN
  SAKIT
  ALPHA
}

enum StatusKedatangan {
  TERLAMBAT
  TEPAT_WAKTU
}

enum Gender {
  L
  P
}

enum Hari {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

model Role {
  id   Int    @id @default(autoincrement())
  name String

  userRole   userRole[]
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?  @db.Timestamptz(6)


  @@index([name, deleted_at])
  @@map("roles")
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique
  password String

  userRole userRole[]

  guru_id Int?  @unique
  guru    Guru? @relation(fields: [guru_id], references: [id], onDelete: SetNull)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@index([deleted_at])
  @@map("users")
}

model userRole {
  user_id String @db.Uuid
  role_id Int
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model Siswa {
  id            String   @id @default(uuid()) @db.Uuid
  NISN          String   @unique @db.VarChar(20)
  NIPD          String   @unique @db.VarChar(20)
  nama          String   @db.VarChar(255)
  alamat        String   @db.Text
  gender        Gender
  tanggal_lahir DateTime @db.Date
  nomor_telepon String   @db.VarChar(15)

  orangtua_id Int?
  kelas_id    Int?

  orang_tua OrangTua?      @relation(fields: [orangtua_id], references: [id], onDelete: SetNull)
  kelas     Kelas?         @relation(fields: [kelas_id], references: [id], onDelete: SetNull)
  rfid      RFID[]
  absensi   AbsensiSiswa[]
  permintaan_status PermintaanStatusAbsensi[]

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@index([kelas_id])
  @@index([orangtua_id])
  @@index([deleted_at])
  @@map("siswa")
}

model OrangTua {
  id            Int    @id @default(autoincrement())
  NIK           String @unique @db.VarChar(20)
  nama_orangtua String @db.VarChar(255)
  nomor_telepon String @db.VarChar(15)
  pekerjaan     String @db.VarChar(255)
  alamat        String @db.Text

  siswa Siswa[]

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@index([deleted_at])
  @@map("orang_tua")
}

model RFID {
  id        Int     @id @default(autoincrement())
  uid_rfid  String  @unique @db.VarChar(50)
  siswa_id  String  @db.Uuid
  is_active Boolean @default(true)

  siswa   Siswa          @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  absensi AbsensiSiswa[]

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@index([siswa_id])
  @@index([is_active])
  @@index([deleted_at])
  @@map("rfid")
}

model AbsensiSiswa {
  id           Int               @id @default(autoincrement())
  siswa_id     String            @db.Uuid
  tanggal      DateTime          @db.Date
  tap_in       DateTime?         @db.Timestamptz(6)
  tap_out      DateTime?         @db.Timestamptz(6)
  rfid_id      Int?
  status_tapin StatusKedatangan?

  status_harian StatusHarian?

  siswa  Siswa                @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  rfid   RFID?                @relation(fields: [rfid_id], references: [id], onDelete: SetNull)
  detail DetailAbsensiSiswa[]

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@unique([siswa_id, tanggal])
  @@index([tanggal])
  @@index([rfid_id])
  @@index([status_tapin])
  @@index([status_harian])
  @@index([deleted_at])
  @@map("absensi_siswa")
}

model DetailAbsensiSiswa {
  id         Int           @id @default(autoincrement())
  absensi_id Int
  jadwal_id  Int?
  guru_id    Int?
  status     StatusAbsensi
  jam_absen  DateTime      @db.Timestamptz(6)
  keterangan String?       @db.Text

  absensi AbsensiSiswa @relation(fields: [absensi_id], references: [id], onDelete: Cascade)
  jadwal  Jadwal?      @relation(fields: [jadwal_id], references: [id], onDelete: SetNull)
  guru    Guru?        @relation(fields: [guru_id], references: [id], onDelete: SetNull)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@index([absensi_id])
  @@index([jadwal_id])
  @@index([guru_id])
  @@index([status])
  @@index([deleted_at])
  @@map("detail_absensi_siswa")
}

model Guru {
  id            Int      @id @default(autoincrement())
  NIP           String   @unique @db.VarChar(20)
  nama          String   @db.VarChar(255)
  nomor_telepon String   @db.VarChar(15)
  alamat        String   @db.Text
  tanggal_lahir DateTime @db.Date

  user User?

  jadwal         Jadwal[]
  detail_absensi DetailAbsensiSiswa[]
  kelas_walas    Kelas[]              @relation("WaliKelas")
  permintaan_sebagai_guru  PermintaanStatusAbsensi[] @relation("GuruPermintaan")
  permintaan_sebagai_walas PermintaanStatusAbsensi[] @relation("WalasPermintaan")

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@index([deleted_at])
  @@map("guru")
}

model Jadwal {
  id          Int      @id @default(autoincrement())
  hari        Hari
  kelas_id    Int
  mapel_id    Int
  guru_id     Int
  jam_mulai   DateTime @db.Time(6)
  jam_selesai DateTime @db.Time(6)

  kelas          Kelas                @relation(fields: [kelas_id], references: [id], onDelete: Restrict)
  mata_pelajaran MataPelajaran        @relation(fields: [mapel_id], references: [id], onDelete: Restrict)
  guru           Guru                 @relation(fields: [guru_id], references: [id], onDelete: Restrict)
  detail_absensi DetailAbsensiSiswa[]

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@unique([kelas_id, hari, jam_mulai])
  @@index([guru_id, hari])
  @@index([hari, kelas_id])
  @@index([mapel_id])
  @@index([deleted_at])
  @@map("jadwal")
}

model MataPelajaran {
  id         Int    @id @default(autoincrement())
  nama_mapel String @db.VarChar(100)

  jadwal Jadwal[]

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@index([deleted_at])
  @@map("mata_pelajaran")
}

model Kelas {
  id                Int     @id @default(autoincrement())
  kelas             String  @db.VarChar(10)
  jurusan           String  @db.VarChar(100)
  tahun_ajaran_id   Int
  telegram_group_id String? @db.VarChar(50)
  walas_id          Int?

  tahun  Tahun    @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Restrict)
  walas  Guru?    @relation("WaliKelas", fields: [walas_id], references: [id], onDelete: Restrict)
  siswa  Siswa[]
  jadwal Jadwal[]
  permintaan_status PermintaanStatusAbsensi[]

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@unique([kelas, jurusan, tahun_ajaran_id])
  @@index([tahun_ajaran_id])
  @@index([deleted_at])
  @@index([walas_id])
  @@map("kelas")
}

model Tahun {
  id              Int      @id @default(autoincrement())
  tahun_ajaran    String   @unique @db.VarChar(20)
  tanggal_mulai   DateTime @db.Date
  tanggal_selesai DateTime @db.Date
  is_active       Boolean  @default(false)

  kelas Kelas[]

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@index([is_active])
  @@index([deleted_at])
  @@map("tahun_ajaran")
}

model PermintaanStatusAbsensi {
  id          Int           @id @default(autoincrement())
  siswa_id    String        @db.Uuid
  kelas_id    Int
  guru_id     Int
  walas_id    Int
  tanggal     DateTime      @db.Date
  status_lama String?       @db.VarChar(20)
  status_baru StatusAbsensi
  keterangan  String?       @db.Text
  is_pending  Boolean       @default(true)
  is_approved Boolean       @default(false)
  is_auto_approved Boolean  @default(false)
  expires_at  DateTime      @db.Timestamptz(6)

  siswa Siswa @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  kelas Kelas @relation(fields: [kelas_id], references: [id], onDelete: Cascade)
  guru  Guru  @relation("GuruPermintaan", fields: [guru_id], references: [id], onDelete: Cascade)
  walas Guru  @relation("WalasPermintaan", fields: [walas_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([walas_id, is_pending])
  @@index([siswa_id, tanggal])
  @@index([expires_at, is_pending])
  @@map("permintaan_status_absensi")
}
